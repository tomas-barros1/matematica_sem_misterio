<% content_for :title, @lesson.title %>

<div class="space-y-6">
  <div class="notebook-card p-6 sm:p-8">
    <p class="math-chip"><%= @lesson.subject.name %></p>
    <h1 class="mt-3 text-3xl font-black text-[#14213d] sm:text-4xl"><%= @lesson.title %></h1>
    <p class="mt-2 max-w-2xl text-[#607083]"><%= @lesson.description %></p>
    <div class="mt-5 flex flex-wrap gap-3 text-sm font-semibold text-[#607083]">
      <span class="rounded-full bg-[#cfe6d5] px-3 py-1 text-[#2454a6]"><%= @lesson.questions.size %>
        questões</span>
      <span class="rounded-full bg-[#e1ebe2] px-3 py-1"><%= @lesson.xp_reward %>
        XP</span>
      <% if @completion.present? %>
        <span class="rounded-full bg-[#fff0c5] px-3 py-1 text-[#856111]">Concluída:
          <%= @completion.score %>%</span>
      <% end %>
    </div>
  </div>

  <% if @completion.present? %>
    <section class="notebook-card p-6" aria-label="Correção da lição">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <p class="text-sm font-semibold text-[#2454a6]">Correção da sua tentativa</p>
          <h2 class="mt-1 text-2xl font-black text-[#14213d]"><%= @completion.score %>% de acertos</h2>
        </div>
        <span class="rounded-full bg-[#e1ebe2] px-3 py-1 text-sm font-semibold text-[#14213d]">
          <%= @lesson.questions.count { |question| question.answer_correct?(@completion.answers[question.id.to_s]) } %> de <%= @lesson.questions.size %> corretas
        </span>
      </div>

      <div class="mt-5 space-y-3">
        <% @lesson.questions.each_with_index do |question, index| %>
          <% submitted_answer = @completion.answers[question.id.to_s] %>
          <% correct = question.answer_correct?(submitted_answer) %>
          <article class="rounded-xl border p-4 <%= correct ? "border-[#a8cfb2] bg-[#edf7ef]" : "border-[#f2b1a2] bg-[#fff0ed]" %>">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="font-bold text-[#14213d]">Questão <%= index + 1 %>: <%= question.statement %></h3>
              <span class="rounded-full px-3 py-1 text-sm font-bold <%= correct ? "bg-[#cfe6d5] text-[#2454a6]" : "bg-[#ffd7cf] text-[#933c2a]" %>">
                <%= correct ? "Você acertou" : "Você errou" %>
              </span>
            </div>
            <p class="mt-3 text-sm text-[#14213d]">Sua resposta: <strong><%= question.answer_label(submitted_answer) || "Não respondida" %></strong></p>
            <% unless correct %>
              <p class="mt-1 text-sm text-[#14213d]">Resposta correta: <strong><%= question.correct_option_label %></strong></p>
            <% end %>
            <% if question.explanation.present? %>
              <p class="mt-3 text-sm text-[#607083]"><strong>Explicação:</strong> <%= question.explanation %></p>
            <% end %>
          </article>
        <% end %>
      </div>
    </section>
  <% end %>

  <%= form_with url: lesson_completion_path(@lesson), scope: :lesson_completion, method: :post, class: "space-y-4" do %>
    <% @lesson.questions.each_with_index do |question, index| %>
      <div class="notebook-card p-6">
        <p class="text-sm font-semibold text-[#607083]">Questão
          <%= index + 1 %></p>
        <h2 class="mt-2 text-xl font-bold text-[#14213d]"><%= question.statement %></h2>

        <% if question.multiple_choice? %>
          <div class="mt-4 grid gap-3">
            <% question.option_pairs.each do |label, option| %>
              <label
                class="answer-option"
              >
                <%= radio_button_tag "lesson_completion[answers][#{question.id}]",
                label,
                false,
                class: "h-4 w-4 text-[#2454a6]" %>
                <span><%= option %></span>
              </label>
            <% end %>
          </div>
        <% else %>
          <div class="mt-4 flex gap-3">
            <label
                class="answer-option flex-1"
            >
              <%= radio_button_tag "lesson_completion[answers][#{question.id}]",
              "true",
              false,
              class: "h-4 w-4 text-[#2454a6]" %>
              <span>Verdadeiro</span>
            </label>
            <label
                class="answer-option flex-1"
            >
              <%= radio_button_tag "lesson_completion[answers][#{question.id}]",
              "false",
              false,
              class: "h-4 w-4 text-[#2454a6]" %>
              <span>Falso</span>
            </label>
          </div>
        <% end %>

      </div>
    <% end %>

    <div class="flex justify-end">
      <%= submit_tag "Finalizar lição",
      class:
        "button-primary px-6" %>
    </div>
  <% end %>
</div>
