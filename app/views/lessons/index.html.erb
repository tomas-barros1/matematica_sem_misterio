<% content_for :title, "Lições" %>

<div class="space-y-8">
  <% @subjects.each do |subject| %>
    <section class="space-y-4">
      <div>
        <h2 class="section-heading"><%= subject.name %></h2>
        <p class="section-subtitle"><%= subject.description %></p>
      </div>

      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        <% subject.lessons.each do |lesson| %>
          <%= render "shared/lesson_card", lesson: lesson %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
