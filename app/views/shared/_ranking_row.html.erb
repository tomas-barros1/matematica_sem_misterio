<div class="flex items-center justify-between gap-4 rounded-3xl bg-white px-5 py-4 shadow-sm ring-1 ring-slate-200">
  <div class="flex items-center gap-4">
    <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-emerald-100 text-lg font-black text-emerald-700">#<%= rank %></div>
    <div>
      <p class="text-lg font-bold text-slate-900"><%= user.display_name %></p>
      <p class="text-sm text-slate-500">Estudante • Nível <%= user.level %></p>
    </div>
  </div>

  <div class="flex items-center gap-2">
    <span class="rounded-full bg-emerald-50 px-3 py-1 text-sm font-bold text-emerald-700"><%= user.xp %> XP</span>
    <span class="rounded-full bg-slate-100 px-3 py-1 text-sm font-bold text-slate-700">Nível <%= user.level %></span>
  </div>
</div>
