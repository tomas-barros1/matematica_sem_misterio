<div class="surface-panel floating-card flex items-center justify-between gap-4 px-5 py-4">
  <div class="flex items-center gap-4">
    <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br from-emerald-500 to-lime-400 text-lg font-black text-white shadow-sm">
      #<%= rank %>
    </div>
    <div>
      <p class="text-lg font-black tracking-tight text-slate-900"><%= user.display_name %></p>
      <p class="text-sm text-slate-500">Nível <%= user.level %></p>
    </div>
  </div>

  <div class="flex items-center gap-2">
    <span class="rounded-full bg-emerald-50 px-3 py-1 text-sm font-bold text-emerald-700"><%= user.xp %> XP</span>
    <span class="rounded-full bg-slate-100 px-3 py-1 text-sm font-bold text-slate-700">Estudante</span>
  </div>
</div>
