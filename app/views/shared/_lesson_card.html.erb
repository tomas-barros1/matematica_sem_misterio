<div class="lesson-card group">
  <div class="p-5">
    <div class="flex items-center justify-between gap-3">
      <p class="rounded-full bg-[#cfe6d5] px-3 py-1 text-xs font-bold uppercase tracking-wide text-[#2454a6]"><%= lesson.subject.name %></p>
      <span class="text-sm font-semibold text-[#607083]"><%= lesson.xp_reward %> XP</span>
    </div>
    <h3 class="mt-4 text-xl font-black tracking-tight text-[#14213d]"><%= lesson.title %></h3>
    <p class="mt-3 text-sm leading-6 text-[#607083]"><%= lesson.description %></p>
    <div class="mt-5 flex items-center justify-between border-t border-[#dce7de] pt-4 text-sm text-[#607083]">
      <span><%= lesson.questions.size %> questões</span>
      <%= link_to "Abrir lição", lesson_path(lesson), class: "lesson-card-link" %>
    </div>
  </div>
</div>
