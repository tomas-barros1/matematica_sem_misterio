<div class="surface-panel floating-card group overflow-hidden">
  <div class="h-2 bg-gradient-to-r from-emerald-500 via-lime-400 to-yellow-300"></div>
  <div class="p-5">
    <div class="flex items-center justify-between gap-3">
      <p class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold uppercase tracking-wide text-emerald-700"><%= lesson.subject.name %></p>
      <span class="text-sm font-semibold text-slate-500"><%= lesson.xp_reward %> XP</span>
    </div>
    <h3 class="mt-4 text-xl font-black tracking-tight text-slate-900"><%= lesson.title %></h3>
    <p class="mt-3 text-sm leading-6 text-slate-600"><%= lesson.description %></p>
    <div class="mt-5 flex items-center justify-between border-t border-slate-100 pt-4 text-sm text-slate-500">
      <span><%= lesson.questions.size %> questões</span>
      <%= link_to "Abrir lição", lesson_path(lesson), class: "inline-flex items-center gap-2 font-semibold text-emerald-700 transition group-hover:gap-3" %>
    </div>
  </div>
</div>
