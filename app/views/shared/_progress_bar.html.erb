<div class="space-y-2">
  <div class="flex items-center justify-between text-sm font-medium text-slate-600">
    <span><%= local_assigns.fetch(:label, "Progresso") %></span>
    <span><%= local_assigns.fetch(:value_label, "#{local_assigns[:percentage]}%") %></span>
  </div>
  <div class="h-3 overflow-hidden rounded-full bg-[#dce7de]">
    <div class="h-full rounded-full bg-[#2454a6]" style="width: <%= local_assigns.fetch(:percentage, 0) %>%"></div>
  </div>
</div>
