<% content_for :title, "Ranking" %>

<div class="space-y-6">
  <div class="reveal surface-panel-accent p-6 sm:p-8">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-white/80">Leaderboard</p>
    <h1 class="mt-2 text-3xl font-black tracking-tight">Ranking</h1>
    <p class="mt-2 max-w-2xl text-sm text-emerald-50">Acompanhe apenas os estudantes mais ativos na jornada de Matemática.</p>
  </div>

  <div class="grid gap-3">
    <% @users.each_with_index do |user, index| %>
      <%= render "shared/ranking_row", user: user, rank: index + 1 %>
    <% end %>
  </div>
</div>
