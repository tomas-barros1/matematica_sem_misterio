<% content_for :title, "Admin - Questões" %>

<div class="space-y-6">
  <div class="flex items-end justify-between gap-4">
    <div>
      <h1 class="text-3xl font-black text-slate-900">Questões</h1>
      <p class="text-slate-600">Banco de perguntas e respostas.</p>
    </div>
    <%= link_to "Nova questão", new_admin_question_path, class: "rounded-full bg-emerald-500 px-4 py-2 text-sm font-semibold text-white" %>
  </div>

  <div class="space-y-3">
    <% @questions.each do |question| %>
      <div class="rounded-3xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-sm font-semibold text-emerald-700"><%= question.lesson.subject.name %> • <%= question.lesson.title %></p>
            <p class="mt-2 text-lg font-bold text-slate-900"><%= question.statement %></p>
            <p class="mt-2 text-sm text-slate-600"><%= question.correct_option_label %></p>
          </div>
          <div class="flex gap-2">
            <%= link_to "Editar", edit_admin_question_path(question), class: "rounded-full bg-slate-900 px-4 py-2 text-sm font-semibold text-white" %>
            <%= button_to "Excluir", admin_question_path(question), method: :delete, class: "rounded-full bg-rose-500 px-4 py-2 text-sm font-semibold text-white" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
