<% content_for :title, "Admin - Usuários" %>

<div class="space-y-6">
  <div class="flex items-end justify-between gap-4">
    <div>
      <h1 class="text-3xl font-black text-slate-900">Usuários</h1>
      <p class="text-slate-600">Gerencie papéis e acompanhe o progresso.</p>
    </div>
  </div>

  <div class="overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-slate-200">
    <table class="min-w-full divide-y divide-slate-200">
      <thead class="bg-slate-50 text-left text-sm font-semibold text-slate-600">
        <tr>
          <th class="px-6 py-4">Nome</th>
          <th class="px-6 py-4">Email</th>
          <th class="px-6 py-4">Papel</th>
          <th class="px-6 py-4">XP</th>
          <th class="px-6 py-4"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @users.each do |user| %>
          <tr>
            <td class="px-6 py-4 font-medium text-slate-900"><%= user.display_name %></td>
            <td class="px-6 py-4 text-slate-600"><%= user.email %></td>
            <td class="px-6 py-4 text-slate-600"><%= role_label(user) %></td>
            <td class="px-6 py-4 text-slate-600"><%= user.xp %></td>
            <td class="px-6 py-4 text-right">
              <%= link_to "Editar", edit_admin_user_path(user), class: "rounded-full bg-slate-900 px-4 py-2 text-sm font-semibold text-white" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
