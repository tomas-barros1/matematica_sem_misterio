<% content_for :title, "Disciplinas" %>

<div class="space-y-6">
  <div>
    <h1 class="section-heading">Disciplinas</h1>
    <p class="section-subtitle">Escolha uma área para estudar.</p>
  </div>

  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    <% @subjects.each do |subject| %>
      <div class="notebook-card floating-card">
        <p class="text-sm font-semibold text-[#2454a6]"><%= subject.lessons.size %> lições</p>
        <h2 class="mt-2 text-2xl font-black text-[#14213d]"><%= subject.name %></h2>
        <p class="mt-2 text-sm text-[#607083]"><%= subject.description %></p>
        <div class="mt-5">
          <%= link_to "Ver disciplina", subject_path(subject), class: "button-primary px-4 py-2" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
