<% content_for :title, @subject.name %>

<div class="space-y-6">
  <div class="surface-panel p-6">
    <p class="math-chip">Disciplina</p>
    <h1 class="mt-3 text-3xl font-black text-slate-900"><%= @subject.name %></h1>
    <p class="mt-2 text-slate-600"><%= @subject.description %></p>
  </div>

  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    <% @subject.lessons.each do |lesson| %>
      <%= render "shared/lesson_card", lesson: lesson %>
    <% end %>
  </div>
</div>
