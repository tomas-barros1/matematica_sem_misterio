<% content_for :title, @subject.name %>

<div class="space-y-6">
  <div class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
    <p class="text-sm font-semibold text-emerald-700">Disciplina</p>
    <h1 class="mt-2 text-3xl font-black text-slate-900"><%= @subject.name %></h1>
    <p class="mt-2 text-slate-600"><%= @subject.description %></p>
  </div>

  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    <% @subject.lessons.each do |lesson| %>
      <%= render "shared/lesson_card", lesson: lesson %>
    <% end %>
  </div>
</div>
