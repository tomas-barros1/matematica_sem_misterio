<% content_for :title, "Entrar" %>

<div class="auth-shell reveal">
  <div class="auth-rail">
    <p class="math-chip bg-white/15 text-white">Bem-vindo de volta</p>
    <h1 class="mt-4 text-4xl font-black tracking-tight">Entrar</h1>
    <p class="mt-3 text-sm leading-6 text-slate-200">Volte a estudar e continue sua sequência.</p>
  </div>

  <div class="p-8">
    <%= render "devise/shared/error_messages", resource: resource %>

    <%= form_with scope: resource_name, url: session_path(resource_name), data: { turbo: false }, class: "mt-6 space-y-4" do |form| %>
      <div>
        <%= form.label :email, "Email", class: "mb-2 block text-sm font-semibold text-slate-700" %>
        <%= form.email_field :email, autofocus: true, autocomplete: "email", class: "form-field" %>
      </div>
      <div data-controller="password-visibility">
        <%= form.label :password, "Senha", class: "mb-2 block text-sm font-semibold text-slate-700" %>
        <div class="relative">
          <%= form.password_field :password,
          autocomplete: "current-password",
          class: "form-field pr-24",
          data: { password_visibility_target: "input" } %>
          <button
            type="button"
            class="absolute inset-y-0 right-3 my-auto h-fit rounded-lg px-2 py-1 text-xs font-extrabold text-[#3565db] transition hover:bg-[#dce8ff]"
            data-password-visibility-target="button"
            data-action="password-visibility#toggle"
            aria-label="Mostrar senha"
            aria-pressed="false"
          >
            Mostrar
          </button>
        </div>
      </div>
      <div class="flex items-center justify-between">
        <label class="flex items-center gap-2 text-sm text-slate-600">
          <%= form.check_box :remember_me, class: "rounded border-slate-300 text-emerald-600" %>
          Lembrar de mim
        </label>
        <%= link_to "Esqueceu sua senha?", new_password_path(resource_name), class: "text-sm font-bold text-[#2454a6]" %>
      </div>
      <%= form.submit "Entrar", class: "button-primary w-full" %>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
