<div class="mt-6 flex flex-wrap gap-3 text-sm font-medium text-slate-600">
  <% if controller_name != "sessions" %>
    <%= link_to "Entrar", new_session_path(resource_name), class: "rounded-full bg-slate-100 px-3 py-1.5 hover:bg-slate-200" %>
  <% end %>
  <% if devise_mapping.registerable? && controller_name != "registrations" %>
    <%= link_to "Registrar", new_registration_path(resource_name), class: "rounded-full bg-slate-100 px-3 py-1.5 hover:bg-slate-200" %>
  <% end %>
  <% if devise_mapping.recoverable? && controller_name != "passwords" %>
    <%= link_to "Esqueceu sua senha?", new_password_path(resource_name), class: "rounded-full bg-slate-100 px-3 py-1.5 hover:bg-slate-200" %>
  <% end %>
</div>
