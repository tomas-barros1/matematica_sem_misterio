<% content_for :title, "Recuperar senha" %>

<div class="auth-shell reveal">
  <div class="auth-rail">
    <p class="math-chip bg-white/15 text-white">Recuperação</p>
    <h1 class="mt-4 text-4xl font-black tracking-tight">Nova senha</h1>
    <p class="mt-3 text-sm leading-6 text-slate-200">Receba o link para criar uma nova senha.</p>
  </div>

  <div class="p-8">
    <%= render "devise/shared/error_messages", resource: resource %>

    <%= form_with scope: resource_name, url: password_path(resource_name), class: "mt-6 space-y-4" do |form| %>
      <div>
        <%= form.label :email, "Email", class: "mb-2 block text-sm font-semibold text-slate-700" %>
        <%= form.email_field :email, autofocus: true, autocomplete: "email", class: "w-full rounded-2xl border-slate-300 px-4 py-3" %>
      </div>
      <%= form.submit "Enviar instruções", class: "w-full rounded-full bg-emerald-500 px-5 py-3 text-sm font-bold text-white hover:bg-emerald-600" %>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
