<% content_for :title, "Registrar" %>

<div class="auth-shell reveal">
  <div class="auth-rail">
    <p class="math-chip bg-white/15 text-white">Crie sua conta</p>
    <h1 class="mt-4 text-4xl font-black tracking-tight">Registrar</h1>
    <p class="mt-3 text-sm leading-6 text-slate-200">Entre para jogar, estudar e evoluir.</p>
  </div>

  <div class="p-8">
    <%= render "devise/shared/error_messages", resource: resource %>

    <%= form_with scope: resource_name, url: registration_path(resource_name), class: "mt-6 space-y-4" do |form| %>
      <div>
        <%= form.label :name, "Nome", class: "mb-2 block text-sm font-semibold text-slate-700" %>
        <%= form.text_field :name, autofocus: true, class: "form-field" %>
      </div>
      <div>
        <%= form.label :email, "Email", class: "mb-2 block text-sm font-semibold text-slate-700" %>
        <%= form.email_field :email, autocomplete: "email", class: "form-field" %>
      </div>
      <div>
        <%= form.label :password, "Senha", class: "mb-2 block text-sm font-semibold text-slate-700" %>
        <%= form.password_field :password, autocomplete: "new-password", class: "form-field" %>
      </div>
      <div>
        <%= form.label :password_confirmation, "Confirmar senha", class: "mb-2 block text-sm font-semibold text-slate-700" %>
        <%= form.password_field :password_confirmation, autocomplete: "new-password", class: "form-field" %>
      </div>
      <%= form.submit "Registrar", class: "button-primary w-full" %>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
